// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  NEW
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffRole {
  DOCTOR
  RECEPTIONIST
  ASSISTANT
  HYGIENIST
  ACCOUNTANT
  ADMIN
}

enum SmokingStatus {
  NON_SMOKER
  SMOKER
  FORMER_SMOKER
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum ToothConditionType {
  HEALTHY
  MISSING
  CARIES
  ROOT_CANAL
  FILLING
  CROWN
  BRIDGE
  IMPLANT
  EXTRACTION
  FRACTURE
  NEEDS_TREATMENT
  COMPLETED_TREATMENT
}

enum PatientFileType {
  XRAY
  CLINICAL_PHOTO
  PDF
  OTHER
}

enum TreatmentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TreatmentPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  PATIENT_CREATED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  TREATMENT_PLAN_CREATED
  STAFF_CREATED
  CLINIC_SETTINGS_UPDATED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Patient {
  id                    String           @id @default(cuid())
  fullName              String
  phone                 String           @unique
  email                 String?
  age                   Int?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  appointments          Appointment[]
  medicalHistory        MedicalHistory?
  dentalVisits          DentalVisit[]
  toothConditions       ToothCondition[]
  files                 PatientFile[]
  treatmentPlans        TreatmentPlan[]
  invoices              Invoice[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Doctor {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  specialty      String?
  phone          String?         @unique
  email          String?         @unique
  isActive       Boolean         @default(true)
  appointments   Appointment[]
  dentalVisits   DentalVisit[]
  treatmentPlans TreatmentPlan[]
  invoices       Invoice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  startTime   DateTime
  endTime     DateTime?
  status      AppointmentStatus @default(NEW)
  reason      String
  notes       String?
  seenAt      DateTime?
  dentalVisit DentalVisit?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([startTime])
  @@index([status])
}

/// Mirrors a Supabase Auth user (id = auth.users.id) for staff/admin accounts.
model Staff {
  id        String    @id
  fullName  String
  email     String    @unique
  phone     String?
  avatarUrl String?
  jobTitle  String?
  notes     String?
  hireDate  DateTime?
  role      StaffRole
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActivityLog {
  id          String     @id @default(cuid())
  actorId     String?
  actorName   String
  actorRole   StaffRole?
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Single-row table (id is always 1) holding every white-label-able piece of
/// clinic identity: branding, contact, address, working hours, social links.
model ClinicSettings {
  id                Int      @id
  clinicName        String
  doctorName        String?
  clinicDescription String?
  licenseNumber     String?
  logoUrl           String?
  faviconUrl        String?
  heroImageUrl      String?
  doctorPhotoUrl    String?
  primaryColor      String?
  secondaryColor    String?
  phone             String
  whatsapp          String?
  email             String?
  website           String?
  country           String?
  city              String?
  address           String?
  googleMapsUrl     String?
  /// Array of 7 entries: [{ day: 0-6 (Sun-Sat), open: "09:00", close: "20:00", closed: bool }]
  workingHours      Json?
  facebookUrl       String?
  instagramUrl      String?
  tiktokUrl         String?
  xUrl              String?
  linkedinUrl       String?
  youtubeUrl        String?
  updatedAt         DateTime @updatedAt
}

/// One row per patient — the patient's standing medical background.
model MedicalHistory {
  id                 String         @id @default(cuid())
  patientId          String         @unique
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies          String[]       @default([])
  chronicDiseases    String[]       @default([])
  currentMedications String[]       @default([])
  previousSurgeries  String[]       @default([])
  smokingStatus      SmokingStatus?
  isPregnant         Boolean?
  bloodType          BloodType?
  medicalNotes       String?
  updatedByStaffId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

/// A single clinical encounter — chief complaint through follow-up, i.e. the
/// "dental record" for that visit. Visit History is simply the list of these.
model DentalVisit {
  id                  String       @id @default(cuid())
  patientId           String
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId       String?      @unique
  appointment         Appointment? @relation(fields: [appointmentId], references: [id])
  visitDate           DateTime     @default(now())
  chiefComplaint      String?
  diagnosis           String?
  treatmentPlan       String?
  proceduresPerformed String[]     @default([])
  prescriptions       String?
  clinicalNotes       String?
  followUpNotes       String?
  cost                Float?
  createdByStaffId    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
}

/// Current state of a single tooth (FDI numbering) on a patient's odontogram.
model ToothCondition {
  id               String             @id @default(cuid())
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber      Int
  condition        ToothConditionType @default(HEALTHY)
  notes            String?
  updatedByStaffId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([patientId, toothNumber])
  @@index([patientId])
}

/// Metadata for files stored in Supabase Storage (x-rays, clinical photos, PDFs).
model PatientFile {
  id                String          @id @default(cuid())
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName          String
  fileType          PatientFileType
  storagePath       String
  fileSize          Int?
  uploadedByStaffId String?
  createdAt         DateTime        @default(now())

  @@index([patientId])
}

/// A structured, billable treatment plan (may span several visits).
model TreatmentPlan {
  id               String              @id @default(cuid())
  patientId        String
  patient          Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor              @relation(fields: [doctorId], references: [id])
  title            String
  diagnosis        String?
  priority         TreatmentPriority   @default(MEDIUM)
  status           TreatmentPlanStatus @default(PLANNED)
  startDate        DateTime?
  estimatedEndDate DateTime?
  notes            String?
  items            TreatmentItem[]
  createdByStaffId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

/// A single procedure/line item within a treatment plan.
model TreatmentItem {
  id              String              @id @default(cuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan       @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedureName   String
  toothNumber     Int?
  quantity        Int                 @default(1)
  unitPrice       Float
  discount        Float               @default(0)
  total           Float
  notes           String?
  status          TreatmentItemStatus @default(PLANNED)
  invoiceItems    InvoiceItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([treatmentPlanId])
}

/// A billing invoice for a patient, generated from treatment items.
model Invoice {
  id               String               @id @default(cuid())
  invoiceNumber    String               @unique
  patientId        String
  patient          Patient              @relation(fields: [patientId], references: [id])
  doctorId         String
  doctor           Doctor               @relation(fields: [doctorId], references: [id])
  issueDate        DateTime             @default(now())
  taxRate          Float?
  taxAmount        Float                @default(0)
  discount         Float                @default(0)
  subtotal         Float
  total            Float
  paidAmount       Float                @default(0)
  remainingBalance Float
  paymentStatus    InvoicePaymentStatus @default(UNPAID)
  notes            String?
  items            InvoiceItem[]
  payments         Payment[]
  createdByStaffId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([paymentStatus])
  @@index([issueDate])
}

/// A billing-time snapshot of a treatment item (kept even if the item changes later).
model InvoiceItem {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatmentItemId String?
  treatmentItem   TreatmentItem? @relation(fields: [treatmentItemId], references: [id])
  description     String
  toothNumber     Int?
  quantity        Int
  unitPrice       Float
  discount        Float          @default(0)
  total           Float
  createdAt       DateTime       @default(now())

  @@index([invoiceId])
}

/// A single in-app notification shown in the admin Notifications Center. Read
/// state is a single global flag (not per-viewer) — a deliberate simplification
/// for a small clinic staff rather than a per-user read-tracking join table.
model Notification {
  id        String               @id @default(cuid())
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  title     String
  message   String
  /// Optional relative path to navigate to when the notification is clicked.
  link      String?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([createdAt])
  @@index([isRead])
  @@index([type])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Float
  method           PaymentMethod
  paidAt           DateTime      @default(now())
  notes            String?
  createdByStaffId String?
  createdAt        DateTime      @default(now())

  @@index([invoiceId])
}
